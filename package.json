{
  "name": "calcudoku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "benchmark:matrix": "node --experimental-strip-types scripts/benchmark-matrix.ts",
    "benchmark:compare": "node --experimental-strip-types scripts/benchmark-compare.ts",
    "analyze:v2": "node --experimental-strip-types scripts/analyze-v2.ts"
  },
  "dependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "^11.0.5",
    "glob@>=9 <=14.0.1": "^14.0.4"
  }
}
